{
  "name": "compute-chain-atlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:market-hours && npm run test:anomaly && npm run test:news && npm run test:history && npm run test:market-snapshot && npm run test:company-enrichment && npm run test:company-profile && npm run test:i18n && npm run test:company-financials && npm run test:research-expansion && npm run test:cross-sector-review && npm run test:annual-business && npm run test:company-display && npm run lint && npm run build",
    "test:market-hours": "node --experimental-strip-types --test tests/market-hours.test.ts",
    "test:anomaly": "node --experimental-strip-types --test tests/anomaly.test.ts",
    "test:news": "node --experimental-strip-types --test tests/news.test.ts",
    "test:history": "node --experimental-strip-types --test tests/history.test.ts",
    "test:market-snapshot": "node --experimental-strip-types --test tests/market-snapshot.test.ts",
    "test:company-enrichment": "node --experimental-strip-types --test tests/company-enrichment.test.ts",
    "test:company-profile": "node --experimental-strip-types --test tests/company-profile-pipeline.test.ts",
    "test:i18n": "node --experimental-strip-types --test tests/i18n.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler --ignore-pattern worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "pages:stage": "node scripts/stage-pages.mjs",
    "test:company-financials": "node --experimental-strip-types --test tests/company-financials.test.ts",
    "dev:local": "COMPUTE_CHAIN_LOCAL_ONLY=1 npm run dev",
    "test:research-expansion": "node --experimental-strip-types --test tests/research-expansion.test.mjs",
    "test:cross-sector-review": "node --experimental-strip-types --test tests/cross-sector-review.test.mjs",
    "test:annual-business": "node --experimental-strip-types --test tests/annual-business.test.mjs",
    "test:company-display": "node --experimental-strip-types --test tests/company-display.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
